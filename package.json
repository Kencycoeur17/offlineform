{
  "name": "@braintechken/offlineform-react",
  "version": "0.1.0",
  "private": true,
  "description": "Opt-in React form draft persistence for unreliable networks",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "demo:dev": "vite --config examples/react-demo/vite.config.ts",
    "demo:build": "vite build --config examples/react-demo/vite.config.ts"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "typescript": "^5.7.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.1.0"
  }
}
